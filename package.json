{
  "name": "deskmate",
  "version": "0.1.7",
  "license": "SEE LICENSE IN LICENSE",
  "description": "DeskMate Windows AI voice input and desktop companion",
  "author": "zuming58",
  "repository": {
    "type": "git",
    "url": "https://github.com/zuming58/DeskMate.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "allowScripts": {
    "electron@44.4.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  },
  "scripts": {
    "dev": "vite",
    "build:input-bridge": "dotnet publish native/DeskMate.InputBridge/DeskMate.InputBridge.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o native/DeskMate.InputBridge/publish",
    "dev:desktop": "npm run build:input-bridge && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs --dev\"",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:desktop": "npm run build:input-bridge && npm run build && electron-builder --win --dir && node scripts/verify-prompt-package.cjs",
    "build:beta": "npm run build:input-bridge && npm run build && electron-builder --win nsis",
    "preview": "vite preview",
    "report:codex-task": "node scripts/report-codex-task-brief.cjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "pinyin-pro": "3.29.3",
    "sherpa-onnx-node": "1.13.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.2.0",
    "electron": "44.4.3",
    "electron-builder": "^26.0.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.deskmate.app",
    "productName": "DeskMate",
    "files": [
      "electron/**/*",
      "dist/client/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "LICENSE", "to": "LICENSE.txt" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
      { "from": "resources/licenses", "to": "licenses", "filter": ["**/*"] },
      {
        "from": "native/DeskMate.InputBridge/publish",
        "to": "input-bridge",
        "filter": [
          "DeskMate.InputBridge.exe"
        ]
      },
      {
        "from": "electron/assets",
        "to": "app-assets",
        "filter": [
          "*.ico",
          "*.png"
        ]
      },
      {
        "from": "resources/wake-model",
        "to": "wake-model",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "integrations/hermes/deskmate-status",
        "to": "integrations/hermes/deskmate-status",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "executableName": "DeskMate",
      "icon": "electron/assets/deskmate-dm.ico"
    },
    "nsis": {
      "license": "LICENSE",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DeskMate",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": ["zh_CN"],
      "artifactName": "DeskMate-${version}-setup.${ext}"
    }
  }
}
