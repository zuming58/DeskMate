# T10D-D user-present reference manual-control candidate only.
#
# This same assembled Xiaozhi previously completed the fixed reference
# firmware's full nod and rotation behavior. Keep the exact reference centers,
# conversion and software envelopes local to the adapter. This is not the
# default product configuration and it does not enable normal MOTION.
CONFIG_DESKMATE_T10DC_SERVO_CALIBRATION_ENABLE=y
CONFIG_DESKMATE_T10DC_INSTALLED_PINOUT_VERIFIED=y
CONFIG_DESKMATE_T10DC_POWER_PATH_VERIFIED=y
CONFIG_DESKMATE_T10DC_COMMON_GROUND_VERIFIED=y
CONFIG_DESKMATE_T10DC_EMERGENCY_CUTOFF_VERIFIED=y

CONFIG_DESKMATE_T10DC_YAW_CENTER_PULSE_US=1500
CONFIG_DESKMATE_T10DC_YAW_MINIMUM_PULSE_US=1055
CONFIG_DESKMATE_T10DC_YAW_MAXIMUM_PULSE_US=1944
CONFIG_DESKMATE_T10DC_YAW_PULSE_PER_DEGREE_US=11
CONFIG_DESKMATE_T10DC_YAW_DIRECTION=1
CONFIG_DESKMATE_T10DC_YAW_CENTER_VERIFIED=y
CONFIG_DESKMATE_T10DC_YAW_DIRECTION_VERIFIED=y
CONFIG_DESKMATE_T10DC_YAW_LIMITS_VERIFIED=y
CONFIG_DESKMATE_T10DC_YAW_PULSE_SCALE_VERIFIED=y

CONFIG_DESKMATE_T10DC_PITCH_CENTER_PULSE_US=1500
CONFIG_DESKMATE_T10DC_PITCH_MINIMUM_PULSE_US=1277
CONFIG_DESKMATE_T10DC_PITCH_MAXIMUM_PULSE_US=1722
CONFIG_DESKMATE_T10DC_PITCH_PULSE_PER_DEGREE_US=11
CONFIG_DESKMATE_T10DC_PITCH_DIRECTION=1
CONFIG_DESKMATE_T10DC_PITCH_CENTER_VERIFIED=y
CONFIG_DESKMATE_T10DC_PITCH_DIRECTION_VERIFIED=y
CONFIG_DESKMATE_T10DC_PITCH_LIMITS_VERIFIED=y
CONFIG_DESKMATE_T10DC_PITCH_PULSE_SCALE_VERIFIED=y
