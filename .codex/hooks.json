{
  "description": "DeskMate Project Flow closure plus privacy-minimized Codex lifecycle status forwarding.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$root/.codex/hooks/codex-status-hook.cjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = (& git rev-parse --show-toplevel 2>$null); if ($root) { & node (Join-Path $root '.codex/hooks/codex-status-hook.cjs') }\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$root/.codex/hooks/codex-status-hook.cjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = (& git rev-parse --show-toplevel 2>$null); if ($root) { & node (Join-Path $root '.codex/hooks/codex-status-hook.cjs') }\"",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$root/.codex/hooks/codex-status-hook.cjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = (& git rev-parse --show-toplevel 2>$null); if ($root) { & node (Join-Path $root '.codex/hooks/codex-status-hook.cjs') }\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$root/.codex/hooks/codex-status-hook.cjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = (& git rev-parse --show-toplevel 2>$null); if ($root) { & node (Join-Path $root '.codex/hooks/codex-status-hook.cjs') }\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$root/.codex/hooks/codex-status-hook.cjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = (& git rev-parse --show-toplevel 2>$null); if ($root) { & node (Join-Path $root '.codex/hooks/codex-status-hook.cjs') }\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$root/.codex/hooks/codex-status-hook.cjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = (& git rev-parse --show-toplevel 2>$null); if ($root) { & node (Join-Path $root '.codex/hooks/codex-status-hook.cjs') }\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; if [ ! -f \"$root/.hooks/stop-doccheck.sh\" ]; then d=\"$PWD\"; while [ \"$d\" != \"/\" ] && [ ! -f \"$d/.hooks/stop-doccheck.sh\" ]; do d=\"$(dirname \"$d\")\"; done; root=\"$d\"; fi; if [ ! -f \"$root/.hooks/stop-doccheck.sh\" ]; then printf '%s\\n' '{\"continue\":true,\"systemMessage\":\"project-flow stop hook script not found\"}'; exit 0; fi; bash \"$root/.hooks/stop-doccheck.sh\" codex",
            "timeout": 30,
            "statusMessage": "收工自检"
          },
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$root/.codex/hooks/codex-status-hook.cjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = (& git rev-parse --show-toplevel 2>$null); if ($root) { & node (Join-Path $root '.codex/hooks/codex-status-hook.cjs') }\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
